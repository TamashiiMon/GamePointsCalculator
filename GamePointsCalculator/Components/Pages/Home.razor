@page "/"
@using Data
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">This is the GamePointsCalculator!</MudText>

@if (DataContext.Players is { Count: > 0 })
{
    <MudDataGrid Items="@Players">
        <Columns>
            <PropertyColumn Property="x => x.PreName" />
            <PropertyColumn Property="x => x.LastName" />
            <PropertyColumn Property="x => x.Points" />
            <PropertyColumn Property="x => x.UserId" />
        </Columns>
    </MudDataGrid>
}
else
{
    <MudText>Noch keine Spieler geladen.</MudText>
}


@code {
    private List<Player> Players = DataContext.Players;
    
}
