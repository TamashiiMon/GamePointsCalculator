@page "/"
@using Data

<PageTitle>Home</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">This is the GamePointsCalculator!</MudText>

@if (DataContext.Players is { Count: > 0 })
{
    <MudDataGrid Items="@Players">
        <Columns>
            <PropertyColumn Property="x => x.PreName" />
            <PropertyColumn Property="x => x.LastName" />
            <PropertyColumn Property="x => x.Points" />
            <PropertyColumn Property="x => x.UserId" />
        </Columns>
    </MudDataGrid>
}
else
{
    <MudText>Noch keine Spieler geladen.</MudText>
}


@code {
    private List<Player> Players => DataContext.Players;

    protected override void OnInitialized()
    {
        DataContext.Players.Clear();
        Player player = new Player();
        player.PreName = "Test";
        player.LastName = "Test";
        player.Points = 100;
        player.UserId = 1;

        Player player2 = new Player();
        player2.PreName = "Test2";
        player2.LastName = "Test2";
        player2.Points = 105;
        player2.UserId = 1;
        
        DataContext.Players.Add(player);
        DataContext.Players.Add(player2);
    }

}
