@page "/"
@using Data
@inject ISnackbar Snackbar

<PageTitle>Home</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">This is the GamePointsCalculator!</MudText>

@if (DataContext.Players is { Count: > 0 })
{
    <MudDataGrid Items="@Players">
        <Columns>
            <PropertyColumn Property="x => x.PreName" />
            <PropertyColumn Property="x => x.LastName" />
            <PropertyColumn Property="x => x.Points" />
            <PropertyColumn Property="x => x.UserId" />
        </Columns>
    </MudDataGrid>
    
    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
               StartIcon="@Icons.Material.Filled.Badge"
               OnClick="@(SubmitWinner)">
        Show winner
    </MudButton>
}
else
{
    <MudText>Noch keine Spieler geladen.</MudText>
}


@code {
    private List<Player> Players = DataContext.Players;

    private void SubmitWinner()
    {
        if (Players.Count == 0)
        {
            Snackbar.Add("No Players Found", Severity.Error);
            return;
        }

        var maxValue = Players.Max(member => member.Points);

        var highestMembers = Players.Where(m => m.Points == maxValue).ToList();

        var winnerText = string.Empty;
       
        foreach (var highestMember in highestMembers)
        {
            if (string.IsNullOrEmpty(winnerText)) winnerText = highestMember.ToString();
            else  winnerText += " & " + highestMember;
        }

        Snackbar.Add("Winner is: " + winnerText, Severity.Info);
    }
}
